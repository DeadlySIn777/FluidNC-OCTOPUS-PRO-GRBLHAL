{
  "build": {
    "core": "stm32",
    "cpu": "cortex-m4",
    "extra_flags": "-DSTM32F446xx -DSTM32F4xx",
    "f_cpu": "180000000L",
    "framework_extra_flags": {
      "arduino": "-D__CORTEX_M4 -DARDUINO_GENERIC_F446ZETX"
    },
    "mcu": "stm32f446zet6",
    "product_line": "STM32F446xx",
    "variant": "STM32F4xx/F446Z(C-E)(H-J-T)_F446ZE(H-J-T)xQ"
  },
  "debug": {
    "jlink_device": "STM32F446ZE",
    "openocd_target": "stm32f4x",
    "svd_path": "STM32F446x.svd"
