{
  "build": {
    "core": "stm32",
    "cpu": "cortex-m4",
    "extra_flags": "-DSTM32F429xx",
    "f_cpu": "168000000L",
    "framework_extra_flags": {
      "arduino": "-D__CORTEX_M4 -DARM_MATH_CM4 -DHAL_UART_MODULE_ENABLED",
      "stm32cube": ""
    },
    "mcu": "stm32f429zgt6",
    "product_line": "STM32F429xx",
    "variant": "STM32F4xx/F427Z(G-I)T_F429ZET_F429Z(G-I)(T-Y)_F437Z(G-I)T_F439Z(G-I)(T-Y)"
  },
  "debug": {
    "default_tools": [
      "stlink"
    ],
    "jlink_device": "STM32F429ZG",
    "openocd_target": "stm32f4x",
    "svd_path": "STM32F429x.svd"
  },
  "frameworks": [
    "arduino",
    "stm32cube",
    "cmsis",
    "libopencm3",
    "zephyr"
  ],
  "name": "STM32F429ZGT6 (1024k Flash, 256k RAM)",
  "upload": {
    "maximum_ram_size": 262144,
    "maximum_size": 1048576,
    "protocol": "dfu",
    "protocols": [
      "dfu",
      "jlink",
      "stlink",
      "blackmagic",
      "cmsis-dap",
      "mbed"
    ]
  },
  "url": "https://www.st.com/en/microcontrollers-microprocessors/stm32f429zg.html",
  "vendor": "ST"
}
